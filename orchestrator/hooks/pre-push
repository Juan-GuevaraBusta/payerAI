#!/bin/sh
# Rechaza push no fast-forward y prohíbe que un worktree de agente
# actualice la rama principal. No sustituye la protección del remoto.
set -eu

zero=0000000000000000000000000000000000000000
git_dir=$(cd "$(git rev-parse --git-dir)" && pwd -P)
common_dir=$(cd "$(git rev-parse --git-common-dir)" && pwd -P)
linked=0
if [ "$git_dir" != "$common_dir" ]; then
  linked=1
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      if [ "$linked" -eq 1 ]; then
        echo "pre-push: un worktree de agente no puede actualizar $remote_ref" >&2
        exit 1
      fi
      ;;
  esac
  if [ "$local_sha" = "$zero" ]; then
    echo "pre-push: no borrar $remote_ref" >&2
    exit 1
  fi
  if [ "$remote_sha" != "$zero" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
      echo "pre-push: rechazo push no fast-forward de $remote_ref" >&2
      exit 1
    fi
  fi
done

exit 0
